<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kart Format"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="OTG ile takılan kart ve USB bellek araçları. Root gerekmez."
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/card_bg"
            android:lineSpacingExtra="3dp"
            android:minHeight="72dp"
            android:padding="16dp"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/filesButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:alpha="0.5"
            android:backgroundTint="@color/accent"
            android:enabled="false"
            android:text="📁  Dosyalar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/formatButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF"
                android:textColor="@color/text"
                android:alpha="0.5"
                android:enabled="false"
                android:text="Biçimlendir"
                android:textAllCaps="false"
                android:textSize="15sp" />

            <Button
                android:id="@+id/imageButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF"
                android:textColor="@color/text"
                android:alpha="0.5"
                android:enabled="false"
                android:text="İmaj yaz"
                android:textAllCaps="false"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/backupButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF"
                android:textColor="@color/text"
                android:alpha="0.5"
                android:enabled="false"
                android:text="Yedek al"
                android:textAllCaps="false"
                android:textSize="15sp" />

            <Button
                android:id="@+id/wipeButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF"
                android:textColor="@color/text"
                android:alpha="0.5"
                android:enabled="false"
                android:text="Sil"
                android:textAllCaps="false"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/benchButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF"
                android:textColor="@color/text"
                android:alpha="0.5"
                android:enabled="false"
                android:text="Hız testi"
                android:textAllCaps="false"
                android:textSize="15sp" />

            <Button
                android:id="@+id/infoButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF"
                android:textColor="@color/text"
                android:alpha="0.5"
                android:enabled="false"
                android:text="Kart bilgisi"
                android:textAllCaps="false"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/windowsButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="4dp"
            android:alpha="0.5"
            android:backgroundTint="#FFFFFF"
            android:enabled="false"
            android:text="Windows kurulum kartı (ISO)"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:max="100" />

        <TextView
            android:id="@+id/progressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/cancelButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="İptal"
            android:textAllCaps="false"
            android:textColor="#C62828"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <Button
            android:id="@+id/refreshButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="Yenile"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="2dp"
            android:text="Biçimlendirme, imaj yazma ve silme karttaki bütün dosyaları siler. Önce yedek alın."
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
